# Pytest
.pytest_cache/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# WorkBuddy 工作区元数据
.workbuddy/

# Environment
.env
.venv/
venv/

# Secrets / certificates
*.key
*.pem

# Unity coverage artifacts
tests/unity/coverage-*
tests/unity/*.info

# BSW C 单元测试编译产物（源码 .c/.h 入库，可执行文件忽略）
