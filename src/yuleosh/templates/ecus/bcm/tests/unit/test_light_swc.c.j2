#include "unity.h"
#include "Light_SWC.h"
#include "Mock_Pwm.h"
#include "Mock_Dio.h"
#include "Mock_Dem.h"

void setUp(void)
{
    Pwm_Init_Expect(&Pwm_Config);
    Pwm_SetOutputToIdle_Expect(PWM_CHANNEL_LOW_BEAM);
    Pwm_SetOutputToIdle_Expect(PWM_CHANNEL_HIGH_BEAM);
    Pwm_SetOutputToIdle_Expect(PWM_CHANNEL_DRL);
    Light_Init();
}

void tearDown(void) {}

void test_Light_SetLowBeam_ActivatesPWM(void)
{
    Pwm_SetDutyCycle_Expect(PWM_CHANNEL_LOW_BEAM, 100U);
    Pwm_GetDutyCycle_ExpectAndReturn(PWM_CHANNEL_LOW_BEAM, 100U);

    Light_SetHeadlight(LIGHT_LOW_BEAM, LIGHT_ON);

    /* Verify internal state */
    TEST_ASSERT(headlightState & LIGHT_LOW_BEAM);
}

void test_Light_HighBeamOff_SetsDutyZero(void)
{
    Pwm_SetDutyCycle_Expect(PWM_CHANNEL_HIGH_BEAM, 0U);
    Pwm_GetDutyCycle_ExpectAndReturn(PWM_CHANNEL_HIGH_BEAM, 0U);

    Light_SetHeadlight(LIGHT_HIGH_BEAM, LIGHT_OFF);

    TEST_ASSERT_FALSE(headlightState & LIGHT_HIGH_BEAM);
}

void test_Light_TurnSignalLeft_DrivesDIOPin(void)
{
    Dio_WriteChannel_Expect(DIO_PIN_TURN_LEFT, 1U);
    Dio_WriteChannel_Expect(DIO_PIN_TURN_RIGHT, 0U);

    Light_ProcessTurnSignals(LIGHT_CMD_TURN_LEFT);
}

void test_Light_Hazard_BothSignals(void)
{
    Dio_WriteChannel_Expect(DIO_PIN_TURN_LEFT, 1U);
    Dio_WriteChannel_Expect(DIO_PIN_TURN_RIGHT, 1U);

    Light_ProcessTurnSignals(LIGHT_CMD_HAZARD);
}

void test_Light_BrakeLightActivates(void)
{
    Dio_WriteChannel_Expect(DIO_PIN_BRAKE_LIGHT, 1U);

    Light_ProcessBrakeLight(LIGHT_CMD_BRAKE);
}
