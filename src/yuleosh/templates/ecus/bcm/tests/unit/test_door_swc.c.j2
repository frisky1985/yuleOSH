#include "Mock_Dio.h"
#include "Mock_Dem.h"

/* ── Test Setup ────────────────────────────────────────────────────── */

void setUp(void)
{
    Door_Init();
}

void tearDown(void)
{
    /* No cleanup needed */
}

/* ── Tests ─────────────────────────────────────────────────────────── */

void test_Door_Init_SetsAllLocksLocked(void)
{
    /* All doors should be locked after init */
    TEST_ASSERT_EQUAL(DOOR_LOCKED, doorLockStates[0]);
    TEST_ASSERT_EQUAL(DOOR_LOCKED, doorLockStates[1]);
    TEST_ASSERT_EQUAL(DOOR_LOCKED, doorLockStates[2]);
    TEST_ASSERT_EQUAL(DOOR_LOCKED, doorLockStates[3]);
}

void test_Door_LockAll_EngagesAllActuators(void)
{
    Dio_WriteChannel_Expect(0U, DOOR_LOCKED);
    Dio_ReadChannel_ExpectAndReturn(0U, DOOR_LOCKED);

    Dio_WriteChannel_Expect(1U, DOOR_LOCKED);
    Dio_ReadChannel_ExpectAndReturn(1U, DOOR_LOCKED);

    Dio_WriteChannel_Expect(2U, DOOR_LOCKED);
    Dio_ReadChannel_ExpectAndReturn(2U, DOOR_LOCKED);

    Dio_WriteChannel_Expect(3U, DOOR_LOCKED);
    Dio_ReadChannel_ExpectAndReturn(3U, DOOR_LOCKED);

    Door_ActuateLock(0U, DOOR_LOCKED);
    Door_ActuateLock(1U, DOOR_LOCKED);
    Door_ActuateLock(2U, DOOR_LOCKED);
    Door_ActuateLock(3U, DOOR_LOCKED);
}

void test_Door_ReadbackMismatch_ReportsDTC(void)
{
    /* Simulate actuator failure: write LOCKED but read UNLOCKED */
    Dio_WriteChannel_Expect(0U, DOOR_LOCKED);
    Dio_ReadChannel_ExpectAndReturn(0U, DOOR_UNLOCKED);

    Dem_ReportErrorStatus_Expect(DTC_DOOR_LOCK_ACTUATOR, DEM_EVENT_STATUS_FAILED);
    Dio_WriteChannel_Expect(0U, DOOR_LOCKED); /* safe state */

    Door_ActuateLock(0U, DOOR_LOCKED);

    /* Door should still be LOCKED in safe state */
    TEST_ASSERT_EQUAL(DOOR_LOCKED, doorLockStates[0]);
}
