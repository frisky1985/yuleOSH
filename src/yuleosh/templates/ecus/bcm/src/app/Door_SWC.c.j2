#include "Door_SWC.h"
#include "Rte_Door_SWC.h"
#include "SchM_Door_SWC.h"

/* ── Local Variables ───────────────────────────────────────────────── */

static Door_LockState doorLockStates[DOOR_NUM_DOORS];
static uint8_t        wiper_delay_stage;
static uint8_t        window_positions[DOOR_NUM_WINDOWS];

/* ── Runnable Functions ────────────────────────────────────────────── */

/**
 * @brief Initialize door control module.
 * Called once during ECU startup (Rte_Start).
 */
FUNC(void, DOOR_CODE) Door_Init(void)
{
    uint8_t i;

    for (i = 0; i < DOOR_NUM_DOORS; i++)
    {
        doorLockStates[i] = DOOR_LOCKED;
    }

    for (i = 0; i < DOOR_NUM_WINDOWS; i++)
    {
        window_positions[i] = 0U;
    }

    wiper_delay_stage = 0U;
}

/**
 * @brief Main runnable — called periodically by RTE (10 ms cycle).
 *
 * Processes CAN/LIN input signals and drives actuator outputs.
 */
FUNC(void, DOOR_CODE) Door_MainFunction(void)
{
    uint8_t doorIndex;
    uint8_t lockCmd;
    uint8_t unlockMask;

    /* Read CAN door lock command */
    (void)Rte_Read_DoorLockCommand(&lockCmd);

    if (lockCmd == DOOR_CMD_LOCK_ALL)
    {
        for (doorIndex = 0; doorIndex < DOOR_NUM_DOORS; doorIndex++)
        {
            Door_ActuateLock(doorIndex, DOOR_LOCKED);
        }
    }
    else if (lockCmd == DOOR_CMD_UNLOCK_SELECTIVE)
    {
        (void)Rte_Read_UnlockMask(&unlockMask);
        for (doorIndex = 0; doorIndex < DOOR_NUM_DOORS; doorIndex++)
        {
            if ((unlockMask & (1U << doorIndex)) != 0U)
            {
                Door_ActuateLock(doorIndex, DOOR_UNLOCKED);
            }
        }
    }

    /* Read door status and publish */
    for (doorIndex = 0; doorIndex < DOOR_NUM_DOORS; doorIndex++)
    {
        uint8_t doorStatus = Door_ReadDoorStatus(doorIndex);
        (void)Rte_Write_DoorStatus(doorIndex, doorStatus);
    }

    /* Mirror control */
    Door_ProcessMirrorControl();
}

/**
 * @brief Actuate a door lock (with read-back safety check, ASIL {{ asil_label }}).
 */
FUNC(void, DOOR_CODE) Door_ActuateLock(uint8_t doorIndex, Door_LockState targetState)
{
    uint8_t actualState;

    /* Write output */
    Dio_WriteChannel(Door_GetLockPin(doorIndex), (uint8_t)targetState);

    /* Safety read-back check */
    actualState = (uint8_t)Dio_ReadChannel(Door_GetLockPin(doorIndex));

    if (actualState != (uint8_t)targetState)
    {
        /* Read-back mismatch — report DTC and enter safe state */
        Dem_ReportErrorStatus(
            DTC_DOOR_LOCK_ACTUATOR,
            DEM_EVENT_STATUS_FAILED
        );
        Door_EnterSafeState(Door_GetLockPin(doorIndex));
    }
    else
    {
        doorLockStates[doorIndex] = targetState;
    }
}

/**
 * @brief Process mirror control commands via LIN.
 */
FUNC(void, DOOR_CODE) Door_ProcessMirrorControl(void)
{
    uint8_t mirrorCmd;
    uint8_t mirrorPosH;
    uint8_t mirrorPosV;

    (void)Rte_Read_MirrorCommand(&mirrorCmd);

    if (mirrorCmd != DOOR_MIRROR_IDLE)
    {
        (void)Rte_Read_MirrorPositionH(&mirrorPosH);
        (void)Rte_Read_MirrorPositionV(&mirrorPosV);

        /* Send LIN frame to mirror actuator */
        LinIf_Transmit(LIN_CHANNEL_MIRROR, mirrorPosH, mirrorPosV);
    }
}

/**
 * @brief Safe state handler for door control.
 */
FUNC(void, DOOR_CODE) Door_EnterSafeState(uint8_t channel)
{
    /* All doors locked, outputs to safe values */
    Dio_WriteChannel(channel, (uint8_t)DOOR_LOCKED);
}
