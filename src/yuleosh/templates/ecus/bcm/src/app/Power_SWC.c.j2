/**
 * @file Power_SWC.c
 * @brief Power Management Software Component — {{ project_name }}
 *
 * Handles power mode management (SLEEP/RUN/STOP), KL15/KL30 monitoring,
 * and low-power wake-up.
 * Safety: ASIL {{ asil_label }}
 *
 * Generated by {{ generated_by }}
 * MCU: {{ mcu }} | Template: {{ template_name }}
 */

#include "Power_SWC.h"
#include "Rte_Power_SWC.h"

/* ── Local Constants ───────────────────────────────────────────────── */

#define VOLTAGE_KL30_UNDERVOLTAGE   (8000U)    /* 8.0 V in mV */
#define VOLTAGE_KL30_OVERVOLTAGE    (16000U)   /* 16.0 V in mV */
#define VOLTAGE_KL15_ON_THRESHOLD   (7000U)    /* 7.0 V  (ignition ON) */
#define KL15_OFF_GRACE_MS           (3000U)    /* 3 second grace period */
#define SLEEP_CURRENT_UA            (100U)     /* < 100 µA target */

/* ── Local Variables ───────────────────────────────────────────────── */

static PowerMode currentMode;
static uint16_t  kl15Voltage_mV;
static uint16_t  kl30Voltage_mV;
static uint16_t  kl15OffTimer;
static uint8_t   wakeupSource;

/* ── Runnable Functions ────────────────────────────────────────────── */

FUNC(void, POWER_CODE) Power_Init(void)
{
    currentMode   = POWER_MODE_INIT;
    kl15OffTimer  = 0U;
    wakeupSource  = 0U;

    /* Initialize ADC for voltage monitoring */
    Adc_Init(&Adc_Config);
    Adc_StartGroupConversion(ADC_GROUP_VOLTAGE);
}

FUNC(void, POWER_CODE) Power_MainFunction(void)
{
    uint16_t kl15Raw;
    uint16_t kl30Raw;

    /* Read KL15 and KL30 voltage via ADC */
    Adc_ReadGroup(ADC_GROUP_VOLTAGE, &kl15Raw);
    Adc_ReadGroup(ADC_GROUP_VOLTAGE_ALT, &kl30Raw);

    /* Convert raw ADC to millivolts (dual ADC channels for safety) */
    kl15Voltage_mV = Power_AdcToMillivolt(kl15Raw);
    kl30Voltage_mV = Power_AdcToMillivolt(kl30Raw);

    /* Voltage monitor every 10 ms */
    Power_MonitorVoltage();

    /* Power mode state machine */
    switch (currentMode)
    {
        case POWER_MODE_INIT:
            Power_TransitionTo(POWER_MODE_RUN);
            break;

        case POWER_MODE_RUN:
            if (kl15Voltage_mV < VOLTAGE_KL15_ON_THRESHOLD)
            {
                kl15OffTimer++;
                if (kl15OffTimer > (KL15_OFF_GRACE_MS / 10U))
                {
                    Power_RequestSleep();
                }
            }
            else
            {
                kl15OffTimer = 0U;
            }
            break;

        case POWER_MODE_STOP:
            /* Waiting for wake-up event */
            if (wakeupSource != 0U)
            {
                Power_TransitionTo(POWER_MODE_RUN);
            }
            break;

        case POWER_MODE_SLEEP:
            /* Low power — wake on CAN/LIN/digital input */
            if (wakeupSource != 0U)
            {
                EcuM_StartWakeupSource((EcuM_WakeupSourceType)wakeupSource);
                Power_TransitionTo(POWER_MODE_RUN);
            }
            break;

        case POWER_MODE_SAFE:
            /* Stay in safe state until external reset */
            break;

        default:
            Power_TransitionTo(POWER_MODE_SAFE);
            break;
    }

    /* Publish power status on CAN */
    (void)Rte_Write_PowerMode((uint8_t)currentMode);
    (void)Rte_Write_Kl15Voltage(kl15Voltage_mV);
    (void)Rte_Write_Kl30Voltage(kl30Voltage_mV);
}

/**
 * @brief Monitor KL15 and KL30 voltage against thresholds (ASIL {{ asil_label }}).
 */
FUNC(void, POWER_CODE) Power_MonitorVoltage(void)
{
    /* KL30 under/over voltage check (ASIL B) */
    if (kl30Voltage_mV < VOLTAGE_KL30_UNDERVOLTAGE)
    {
        Dem_ReportErrorStatus(DTC_VOLTAGE_KL30_UNDER, DEM_EVENT_STATUS_FAILED);
        Power_TransitionTo(POWER_MODE_SAFE);
    }
    else if (kl30Voltage_mV > VOLTAGE_KL30_OVERVOLTAGE)
    {
        Dem_ReportErrorStatus(DTC_VOLTAGE_KL30_OVER, DEM_EVENT_STATUS_FAILED);
        Power_TransitionTo(POWER_MODE_SAFE);
    }

    /* KL15 voltage monitoring */
    if (kl15Voltage_mV < VOLTAGE_KL15_ON_THRESHOLD)
    {
        Dem_ReportErrorStatus(DTC_VOLTAGE_KL15_LOW, DEM_EVENT_STATUS_FAILED);
    }
}

FUNC(void, POWER_CODE) Power_RequestSleep(void)
{
    /* Notify other SWCs of impending sleep */
    (void)Rte_Write_SleepRequest(1U);

    /* Wait for all SWCs to acknowledge */
    Power_TransitionTo(POWER_MODE_SLEEP);
}

FUNC(void, POWER_CODE) Power_TransitionTo(PowerMode newMode)
{
    currentMode = newMode;

    switch (newMode)
    {
        case POWER_MODE_RUN:
            /* Restore full power */
            Mcu_SetMode(MCU_MODE_NORMAL);
            break;

        case POWER_MODE_STOP:
            /* Stop clocks, keep RAM */
            Mcu_SetMode(MCU_MODE_STOP);
            break;

        case POWER_MODE_SLEEP:
            /* Deep sleep, minimal current */
            Mcu_SetMode(MCU_MODE_SLEEP);
            break;

        case POWER_MODE_SAFE:
            /* Safe state: all outputs to safe values */
            Dio_WriteChannelGroup(&Dio_Config_Outputs, 0x00000000U);
            break;

        default:
            break;
    }
}

/**
 * @brief Convert ADC raw value to millivolts.
 */
static inline uint16_t Power_AdcToMillivolt(uint16_t raw)
{
    /* Assuming 12-bit ADC with Vref = 3.3V */
    /* raw * 3300 / 4096 */
    return (uint16_t)(((uint32_t)raw * 3300UL) / 4096UL);
}
