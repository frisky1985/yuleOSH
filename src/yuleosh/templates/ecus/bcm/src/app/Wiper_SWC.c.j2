#include "Wiper_SWC.h"
#include "Rte_Wiper_SWC.h"

/* ── Local Constants ───────────────────────────────────────────────── */

#define WIPER_PARK_POSITION         (0U)
#define RAIN_SENSOR_THRESHOLD       (50U)
#define WASHER_ACTIVE_TIME_MS       (1500U)
#define WIPER_WASH_CYCLES           (3U)

/* ── Local Variables ───────────────────────────────────────────────── */

static uint8_t  wiperMode;
static uint8_t  wiperSpeed;
static uint16_t rainSensorValue;
static uint16_t wiperTimer;
static uint8_t  washCycleCount;

/* ── Runnable Functions ────────────────────────────────────────────── */

FUNC(void, WIPER_CODE) Wiper_Init(void)
{
    wiperMode       = WIPER_MODE_OFF;
    wiperSpeed      = WIPER_SPEED_PARK;
    rainSensorValue = 0U;
    wiperTimer      = 0U;
    washCycleCount  = 0U;

    /* Ensure wipers are parked */
    Dio_WriteChannel(DIO_PIN_WIPER_SPEED, WIPER_SPEED_PARK);
}

FUNC(void, WIPER_CODE) Wiper_MainFunction(void)
{
    uint8_t cmdSpeed;
    uint8_t cmdMode;

    /* Read wiper command from CAN */
    (void)Rte_Read_WiperCommand(&cmdMode);

    /* Read rain sensor via LIN */
    (void)Rte_Read_RainSensor(&rainSensorValue);

    if (cmdMode == WIPER_MODE_AUTO)
    {
        /* Auto mode: use rain sensor */
        if (rainSensorValue > RAIN_SENSOR_THRESHOLD)
        {
            /* Map rain intensity to speed */
            if (rainSensorValue > 200U)
            {
                cmdSpeed = WIPER_SPEED_HIGH;
            }
            else if (rainSensorValue > 100U)
            {
                cmdSpeed = WIPER_SPEED_LOW;
            }
            else
            {
                cmdSpeed = WIPER_SPEED_INTERMITTENT;
            }

            Wiper_SetSpeed(cmdSpeed);
        }
        else
        {
            /* No rain detected — park wipers */
            Wiper_Park();
        }
    }
    else
    {
        /* Manual mode: use command value */
        switch (cmdMode)
        {
            case WIPER_MODE_LOW:
                Wiper_SetSpeed(WIPER_SPEED_LOW);
                break;
            case WIPER_MODE_HIGH:
                Wiper_SetSpeed(WIPER_SPEED_HIGH);
                break;
            case WIPER_MODE_INTERMITTENT:
                Wiper_SetSpeedWithDelay(WIPER_SPEED_INTERMITTENT, wiper_delay_stage);
                break;
            case WIPER_MODE_WASH:
                Wiper_ExecuteWashWipe();
                break;
            default:
                Wiper_Park();
                break;
        }
    }

    /* Report wiper status on CAN */
    (void)Rte_Write_WiperStatus(wiperMode, wiperSpeed);
}

FUNC(void, WIPER_CODE) Wiper_SetSpeed(uint8_t speed)
{
    if (speed == WIPER_SPEED_PARK)
    {
        Wiper_Park();
        return;
    }

    wiperSpeed = speed;
    wiperMode  = WIPER_MODE_MANUAL;

    /* Drive wiper motor speed output */
    Dio_WriteChannel(DIO_PIN_WIPER_SPEED, speed);
}

FUNC(void, WIPER_CODE) Wiper_SetSpeedWithDelay(uint8_t speed, uint8_t delayStage)
{
    uint16_t delayMs;

    /* Intermittent delay map */
    static const uint16_t delayMap[5] = {2000U, 4000U, 6000U, 8000U, 10000U};

    if (delayStage > 4U)
    {
        delayStage = 4U;
    }

    delayMs = delayMap[delayStage];
    wiperTimer = (wiperTimer + 1U) % delayMs;

    if (wiperTimer == 0U)
    {
        Wiper_SetSpeed(speed);
    }
}

FUNC(void, WIPER_CODE) Wiper_Park(void)
{
    wiperSpeed = WIPER_SPEED_PARK;
    wiperMode  = WIPER_MODE_OFF;

    Dio_WriteChannel(DIO_PIN_WIPER_SPEED, WIPER_SPEED_PARK);

    /* Verify park position (read-back) */
    if (Dio_ReadChannel(DIO_PIN_WIPER_SPEED) != WIPER_SPEED_PARK)
    {
        Dem_ReportErrorStatus(DTC_WIPER_PARK_FAILED, DEM_EVENT_STATUS_FAILED);
    }
}

FUNC(void, WIPER_CODE) Wiper_ExecuteWashWipe(void)
{
    /* Activate washer pump */
    Dio_WriteChannel(DIO_PIN_WASHER_PUMP, 1U);

    /* Perform wipe cycles */
    for (washCycleCount = 0; washCycleCount < WIPER_WASH_CYCLES; washCycleCount++)
    {
        Wiper_SetSpeed(WIPER_SPEED_LOW);
        /* In real system, wait for wipe cycle completion */
    }

    /* Deactivate washer pump */
    Dio_WriteChannel(DIO_PIN_WASHER_PUMP, 0U);

    /* Final wipe and park */
    Wiper_Park();
}
