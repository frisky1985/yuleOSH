#include "Light_SWC.h"
#include "Rte_Light_SWC.h"

/* ── Local Constants ───────────────────────────────────────────────── */

#define TURN_SIGNAL_PERIOD_MS       (667U)     /* 1.5 Hz → 667 ms */
#define TURN_SIGNAL_DUTY_CYCLE      (50U)      /* 50% duty */
#define HEADLIGHT_RAMP_MS           (50U)      /* 50 ms transition */
#define INTERIOR_FADE_MS            (500U)     /* 500 ms fade */
#define BRAKE_RESPONSE_MS           (50U)      /* 50 ms brake light activation */
#define DRL_ACTIVATION_DELAY_MS     (200U)     /* 200 ms DRL on after engine */

/* ── Local Variables ───────────────────────────────────────────────── */

static uint8_t  headlightState;
static uint8_t  turnSignalState;
static uint16_t interiorBrightness;
static uint16_t brakeLightTimer;

/* ── Runnable Functions ────────────────────────────────────────────── */

FUNC(void, LIGHT_CODE) Light_Init(void)
{
    headlightState    = LIGHT_OFF;
    turnSignalState   = LIGHT_TURN_IDLE;
    interiorBrightness = 0U;
    brakeLightTimer   = 0U;

    /* Initialize PWM outputs to safe state */
    Pwm_Init(&Pwm_Config);
    Pwm_SetOutputToIdle(PWM_CHANNEL_LOW_BEAM);
    Pwm_SetOutputToIdle(PWM_CHANNEL_HIGH_BEAM);
    Pwm_SetOutputToIdle(PWM_CHANNEL_DRL);
}

FUNC(void, LIGHT_CODE) Light_MainFunction(void)
{
    uint8_t lightCmd;

    /* Read light control command from CAN */
    (void)Rte_Read_LightCommand(&lightCmd);

    /* Headlight control */
    if (lightCmd & LIGHT_CMD_LOW_BEAM)
    {
        Light_SetHeadlight(LIGHT_LOW_BEAM, LIGHT_ON);
    }
    else
    {
        Light_SetHeadlight(LIGHT_LOW_BEAM, LIGHT_OFF);
    }

    if (lightCmd & LIGHT_CMD_HIGH_BEAM)
    {
        Light_SetHeadlight(LIGHT_HIGH_BEAM, LIGHT_ON);
    }
    else
    {
        Light_SetHeadlight(LIGHT_HIGH_BEAM, LIGHT_OFF);
    }

    /* Turn signal control */
    Light_ProcessTurnSignals(lightCmd);

    /* Interior lighting */
    Light_ProcessInterior(lightCmd);

    /* Brake light */
    Light_ProcessBrakeLight(lightCmd);
}

FUNC(void, LIGHT_CODE) Light_SetHeadlight(uint8_t beam, uint8_t state)
{
    Pwm_ChannelType channel;
    uint16_t duty;

    if (beam == LIGHT_LOW_BEAM)
    {
        channel = PWM_CHANNEL_LOW_BEAM;
    }
    else
    {
        channel = PWM_CHANNEL_HIGH_BEAM;
    }

    if (state == LIGHT_ON)
    {
        duty = 100U; /* 100% duty = full brightness */
        headlightState |= beam;
    }
    else
    {
        duty = 0U;
        headlightState &= ~(uint8_t)beam;
    }

    Pwm_SetDutyCycle(channel, duty);

    /* Safety: read-back PWM duty cycle */
    if (Pwm_GetDutyCycle(channel) != duty)
    {
        Dem_ReportErrorStatus(DTC_LIGHT_PWM_FAULT, DEM_EVENT_STATUS_FAILED);
        Pwm_SetOutputToIdle(channel);
    }
}

FUNC(void, LIGHT_CODE) Light_ProcessTurnSignals(uint8_t lightCmd)
{
    uint8_t signals;

    signals = 0U;

    if (lightCmd & LIGHT_CMD_TURN_LEFT)
    {
        signals |= LIGHT_TURN_LEFT;
    }

    if (lightCmd & LIGHT_CMD_TURN_RIGHT)
    {
        signals |= LIGHT_TURN_RIGHT;
    }

    if (lightCmd & LIGHT_CMD_HAZARD)
    {
        signals |= (LIGHT_TURN_LEFT | LIGHT_TURN_RIGHT);
    }

    turnSignalState = signals;

    /* Drive turn signal PWM outputs */
    Dio_WriteChannel(DIO_PIN_TURN_LEFT, (signals & LIGHT_TURN_LEFT) ? 1U : 0U);
    Dio_WriteChannel(DIO_PIN_TURN_RIGHT, (signals & LIGHT_TURN_RIGHT) ? 1U : 0U);
}

FUNC(void, LIGHT_CODE) Light_ProcessInterior(uint8_t lightCmd)
{
    uint8_t targetBrightness;

    targetBrightness = 0U;

    if (lightCmd & LIGHT_CMD_INTERIOR_ON)
    {
        targetBrightness = 100U;
    }
    else if (lightCmd & LIGHT_CMD_DOOR_OPEN)
    {
        targetBrightness = 80U;
    }

    if (targetBrightness > interiorBrightness)
    {
        interiorBrightness += 10U;
        if (interiorBrightness > targetBrightness)
        {
            interiorBrightness = targetBrightness;
        }
    }
    else if (targetBrightness < interiorBrightness)
    {
        interiorBrightness -= 10U;
    }

    Pwm_SetDutyCycle(PWM_CHANNEL_INTERIOR, interiorBrightness);
}

FUNC(void, LIGHT_CODE) Light_ProcessBrakeLight(uint8_t lightCmd)
{
    if (lightCmd & LIGHT_CMD_BRAKE)
    {
        Dio_WriteChannel(DIO_PIN_BRAKE_LIGHT, 1U);
        brakeLightTimer = 0U;

        /* Emergency brake flash detection */
        if (lightCmd & LIGHT_CMD_EMERGENCY_BRAKE)
        {
            /* Toggle at 4 Hz for emergency brake */
            Dio_WriteChannel(DIO_PIN_BRAKE_LIGHT,
                (brakeLightTimer & 0x01U) ? 1U : 0U);
        }
    }
    else
    {
        Dio_WriteChannel(DIO_PIN_BRAKE_LIGHT, 0U);
    }
}
