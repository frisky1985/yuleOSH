# CI Configuration for {{ project_name }} (BCM)
# Generated by yuleOSH init from {{ template_name }} template
# MCU: {{ mcu }} | ASIL: {{ asil_label }}

misra:
  profiles: {}
  active_profile: safety
  deviations:
    - rule: "Dir 4.1"
      file: "tests/**"
      reason: "Test frameworks use non-compliant patterns intentionally"
    - rule: "R 10.1"
      file: "src/bsw/**"
      reason: "Hardware abstraction — value range verified by runtime checks"
  exclude_paths:
    - "tests/**"
    - "build/**"
  code_categories:
    application:
      paths:
        - "src/app/**"
      action: "enforce"
      block_on: true
    bsw:
      paths:
        - "src/bsw/**"
      action: "enforce"
      block_on: true

coverage:
  threshold_line: 70.0
  threshold_condition: 60.0
  strict: true
  c_fail_under: 70
  module_thresholds:
    Door_SWC:
      line: 80
    Light_SWC:
      line: 80
    Wiper_SWC:
      line: 80
    Power_SWC:
      line: 85

gate:
  require_pass:
    - spec_validate
    - misra_check
    - unit_test
    - coverage_check
  block_on:
    - misra_check
    - unit_test
  warn_on:
    - coverage_check
  pre_commit_checklist:
    - spec_validate
    - misra_check
    - unit_test
  pre_release_checklist:
    - spec_validate
    - misra_check
    - unit_test
    - coverage_check
    - safety_review
    - traceability_check
