#include "unity.h"
#include "AssistTorque_SWC.h"
#include "Mock_Dem.h"

void setUp(void) { AssistTorque_Init(); }
void tearDown(void) {}

void test_AssistTorque_SpeedDependent(void)
{
    int16_t lowSpeedTorque = AssistTorque_Calculate(3.0f, 30.0f);
    int16_t highSpeedTorque = AssistTorque_Calculate(3.0f, 120.0f);
    TEST_ASSERT(lowSpeedTorque >= highSpeedTorque);
}

void test_AssistTorque_ZeroInput(void)
{
    int16_t torque = AssistTorque_Calculate(0.0f, 0.0f);
    TEST_ASSERT_EQUAL(0, torque);
}
