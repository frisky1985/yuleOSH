/**
 * @file TorqueManager_SWC.c
 * @brief Torque Management SWC — {{ project_name }}
 *
 * Core torque calculation and monitoring with ASIL {{ asil_label }} decomposition.
 * Dual-core lockstep: Core 0 = TorqueManager, Core 1 = TorqueMonitor.
 *
 * Generated by {{ generated_by }}
 * MCU: {{ mcu }} | Template: {{ template_name }}
 */

#include "TorqueManager_SWC.h"
#include "Rte_TorqueManager_SWC.h"

/* ── Constants ─────────────────────────────────────────────────────── */

#define PEDAL_THRESHOLD_DEVIATION   (5U)   /* 5% */
#define PEDAL_FAULT_DEVIATION       (10U)  /* 10% */
#define TORQUE_SLEW_RATE_MAX        (500U) /* 500 Nm/s */
#define E2E_FAILURE_LIMIT           (3U)   /* consecutive failures */
#define TORQUE_MONITOR_CYCLE_MS     (10U)

/* ── Local Variables ───────────────────────────────────────────────── */

static uint16_t pedalRawApp1;
static uint16_t pedalRawApp2;
static int16_t  demandedTorque;
static int16_t  monitoredTorque;
static uint8_t  e2eFailureCount;

/* ── Runnable Functions ────────────────────────────────────────────── */

FUNC(void, VCU_CODE) TorqueManager_Init(void)
{
    demandedTorque   = 0;
    monitoredTorque  = 0;
    e2eFailureCount  = 0U;
}

FUNC(void, VCU_CODE) TorqueManager_MainFunction(void)
{
    uint8_t pedalValid;
    int16_t driverTorque;
    int16_t espIntervention;
    int16_t cruiseTorque;

    /* Read dual pedal sensors (ASIL D redundant) */
    (void)Rte_Read_AccelPedalApp1(&pedalRawApp1);
    (void)Rte_Read_AccelPedalApp2(&pedalRawApp2);

    /* Validate pedal plausibility */
    pedalValid = TorqueManager_ValidatePedal(pedalRawApp1, pedalRawApp2);

    if (!pedalValid)
    {
        /* Pedal plausibility fault — enter limp-home */
        Dem_ReportErrorStatus(DTC_PEDAL_PLAUSIBILITY, DEM_EVENT_STATUS_FAILED);
        demandedTorque = VCU_LIMP_HOME_TORQUE;
    }
    else
    {
        /* Calculate driver torque demand (use lower of two sensors) */
        uint16_t validPedal = (pedalRawApp1 < pedalRawApp2) ? pedalRawApp1 : pedalRawApp2;
        driverTorque = TorqueManager_MapPedalToTorque(validPedal);

        /* Read other torque requests */
        (void)Rte_Read_EspTorqueIntervention(&espIntervention);
        (void)Rte_Read_CruiseTorqueRequest(&cruiseTorque);

        /* Torque arbitration: minimum request wins */
        demandedTorque = driverTorque;
        if (espIntervention < demandedTorque)
        {
            demandedTorque = espIntervention;
        }
        if ((cruiseTorque > 0) && (cruiseTorque < demandedTorque))
        {
            demandedTorque = cruiseTorque;
        }

        /* Slew rate limiting */
        TorqueManager_ApplySlewRate(TORQUE_SLEW_RATE_MAX, TORQUE_MONITOR_CYCLE_MS);
    }

    /* Send torque command to inverter */
    (void)Rte_Write_TorqueSetpoint(demandedTorque);

    /* E2E protect torque CAN signal */
    TorqueManager_ProtectTorqueSignal();

    /* Brake-over-accelerator logic */
    uint8_t brakeActive;
    (void)Rte_Read_BrakeSwitch(&brakeActive);
    if (brakeActive && (demandedTorque > 0))
    {
        demandedTorque = 0;
        (void)Rte_Write_TorqueSetpoint(0);
    }

    /* Publish monitoring data */
    (void)Rte_Write_TorqueMonitoring(monitoredTorque, demandedTorque);
}

/**
 * @brief Validate dual pedal sensor plausibility.
 * @return 1 if valid, 0 if fault detected.
 */
static uint8_t TorqueManager_ValidatePedal(uint16_t app1, uint16_t app2)
{
    uint16_t deviation;

    if (app1 > app2)
    {
        deviation = app1 - app2;
    }
    else
    {
        deviation = app2 - app1;
    }

    if (deviation > PEDAL_FAULT_DEVIATION)
    {
        return 0U; /* Plausibility fault */
    }

    return 1U; /* Valid */
}

/**
 * @brief Map validated pedal percentage to torque demand.
 */
static int16_t TorqueManager_MapPedalToTorque(uint16_t pedalPercent)
{
    /* Linear mapping: 0-100% pedal → 0-200 Nm torque */
    /* ASIL D requirement: lookup table in ROM for diverse implementation */
    static const int16_t pedalMap[11] = {
        0, 20, 40, 60, 80, 100, 120, 140, 160, 180, 200
    };

    uint8_t index = (uint8_t)(pedalPercent / 10U);
    if (index > 10U) index = 10U;
    return pedalMap[index];
}

/**
 * @brief Apply torque slew rate limitation.
 */
static void TorqueManager_ApplySlewRate(uint16_t maxSlewPerSec, uint16_t cycleMs)
{
    static int16_t lastTorque = 0;

    int16_t maxDelta = (int16_t)((uint32_t)maxSlewPerSec * cycleMs / 1000U);
    int16_t delta = demandedTorque - lastTorque;

    if (delta > maxDelta)
    {
        demandedTorque = lastTorque + maxDelta;
    }
    else if (delta < -maxDelta)
    {
        demandedTorque = lastTorque - maxDelta;
    }

    lastTorque = demandedTorque;
}

/**
 * @brief Independent torque monitoring path (runs on Core 1).
 * Cross-compared with TorqueManager result.
 */
FUNC(void, VCU_CODE) TorqueMonitor_IndependentCheck(void)
{
    /* Diverse calculation: use polynomial instead of lookup table */
    uint16_t pedalAvg = (pedalRawApp1 + pedalRawApp2) / 2U;
    int16_t monTorque;

    /* Alternative calculation: torque = 2.0 * pedal */
    monTorque = (int16_t)(pedalAvg * 2);

    if (monTorque != demandedTorque)
    {
        e2eFailureCount++;
        if (e2eFailureCount >= E2E_FAILURE_LIMIT)
        {
            /* Cross-check failure — enter safe state */
            Dem_ReportErrorStatus(DTC_TORQUE_MONITOR_MISMATCH, DEM_EVENT_STATUS_FAILED);
            demandedTorque = 0;
            (void)Rte_Write_TorqueSetpoint(0);
        }
    }
    else
    {
        e2eFailureCount = 0U;
    }

    monitoredTorque = monTorque;
}

/**
 * @brief E2E protection for torque CAN signal.
 */
static void TorqueManager_ProtectTorqueSignal(void)
{
    /* E2E profile 1: CRC + sequence counter appended to CAN frame */
    static uint8_t seqCounter = 0U;

    seqCounter++;
    (void)Rte_Write_TorqueE2eCrc(TorqueManager_ComputeCrc(demandedTorque, seqCounter));
    (void)Rte_Write_TorqueE2eCounter(seqCounter);
}

static uint8_t TorqueManager_ComputeCrc(int16_t torque, uint8_t counter)
{
    uint8_t crc = (uint8_t)(torque & 0xFFU);
    crc ^= (uint8_t)((uint16_t)torque >> 8U);
    crc ^= counter;
    crc ^= 0x2DU; /* Polynomial constant */
    return crc;
}
