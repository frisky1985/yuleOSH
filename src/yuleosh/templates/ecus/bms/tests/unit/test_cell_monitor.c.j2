void test_CellMonitor_Overvoltage_Detected(void)
{
    uint16_t result = CellMonitor_CheckOvervoltage(4200);
    TEST_ASSERT_EQUAL(1, result);
}

void test_CellMonitor_NormalVoltage_NoFault(void)
{
