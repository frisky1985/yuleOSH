# CI Configuration for {{ project_name }} (DCU)
# Generated by yuleOSH init from {{ template_name }} template
# MCU: {{ mcu }} | ASIL: {{ asil_label }}

misra:
  active_profile: safety
  deviations:
    - rule: "Dir 4.1"
      file: "tests/**"
      reason: "Test frameworks use non-compliant patterns intentionally"
  exclude_paths:
    - "tests/**"
    - "build/**"

coverage:
  threshold_line: 65.0
  threshold_condition: 55.0
  strict: true
  c_fail_under: 60
  module_thresholds:
    Gateway_SWC:
      line: 75
    CanRouter_SWC:
      line: 75

gate:
  require_pass:
    - spec_validate
    - misra_check
    - unit_test
  block_on:
    - misra_check
    - unit_test
  pre_commit_checklist:
    - spec_validate
    - misra_check
    - unit_test
  pre_release_checklist:
    - spec_validate
    - misra_check
    - unit_test
    - safety_review
