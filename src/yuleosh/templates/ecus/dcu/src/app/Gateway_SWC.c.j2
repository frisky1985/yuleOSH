#include "Gateway_SWC.h"
#include "Rte_Gateway_SWC.h"
#include "SchM_Gateway_SWC.h"

/* ── Route Table ───────────────────────────────────────────────────── */

#define ROUTE_TABLE_MAX         (256U)
#define ROUTE_TABLE_CRC_SEED    (0xA5U)

typedef struct
{
    uint32_t    canId;
    uint8_t     sourceBus;
    uint8_t     targetBus;
    uint8_t     enabled;
    uint8_t     padding;
    uint16_t    fwdCount;
} RouteEntry;

static RouteEntry routeTable[ROUTE_TABLE_MAX];
static uint8_t    numRoutes;
static uint16_t   routeTableCrc;

/* ── Runnable Functions ────────────────────────────────────────────── */

FUNC(void, GW_CODE) Gateway_Init(void)
{
    numRoutes = 0U;
    routeTableCrc = 0U;
}

FUNC(void, GW_CODE) Gateway_MainFunction(void)
{
    uint8_t i;
    uint16_t computedCrc;

    /* Verify route table integrity (ASIL B) */
    computedCrc = Gateway_ComputeCrc(routeTable, numRoutes * sizeof(RouteEntry));
    if (computedCrc != routeTableCrc)
    {
        Dem_ReportErrorStatus(DTC_ROUTE_TABLE_CORRUPT, DEM_EVENT_STATUS_FAILED);
        Gateway_EnterSafeState();
        return;
    }

    /* Process received CAN messages */
    for (i = 0; i < numRoutes; i++)
    {
        if (!routeTable[i].enabled)
        {
            continue;
        }

        Gateway_ProcessRoute(&routeTable[i]);
    }
}

FUNC(void, GW_CODE) Gateway_ProcessRoute(RouteEntry *entry)
{
    uint8_t pduBuffer[8];
    uint8_t pduLength;

    /* Read incoming PDU from source bus */
    if (CanIf_ReadRxPdu(entry->sourceBus, entry->canId, pduBuffer, &pduLength) == E_OK)
    {
        /* Forward to target bus */
        if (CanIf_Transmit(entry->targetBus, entry->canId, pduBuffer, pduLength) == E_OK)
        {
            entry->fwdCount++;
        }
        else
        {
            Dem_ReportErrorStatus(DTC_ROUTE_FWD_FAILED, DEM_EVENT_STATUS_FAILED);
        }
    }
}

FUNC(void, GW_CODE) Gateway_EnterSafeState(void)
{
    uint8_t i;

    /* Disable all routes */
    for (i = 0; i < numRoutes; i++)
    {
        routeTable[i].enabled = 0U;
    }
}

/**
 * @brief Simple CRC-16 for route table integrity check.
 */
static uint16_t Gateway_ComputeCrc(const void *data, uint16_t length)
{
    const uint8_t *bytes = (const uint8_t *)data;
    uint16_t crc = ROUTE_TABLE_CRC_SEED;
    uint16_t i;

    for (i = 0; i < length; i++)
    {
        crc ^= (uint16_t)bytes[i] << 8;
        for (uint8_t bit = 0; bit < 8; bit++)
        {
            if (crc & 0x8000U)
            {
                crc = (crc << 1) ^ 0x8005U;
            }
            else
            {
                crc <<= 1;
            }
        }
    }
    return crc;
}
