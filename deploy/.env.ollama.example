# =============================================================================
# yuleOSH — 本地 LLM 接入（本机 Ollama / 任意 OpenAI 兼容端点）
# =============================================================================
# 用途：把 yuleOSH 的真实 LLM 链路指向本机已运行的模型，无需任何外部 API key、
#       零费用。对应需求：外部 LLM 全部不可用时（DeepSeek 402 / OpenAI 配置错误
#       / Anthropic key 误填），把真实 LLM 链路跑通的最快路径。
#
# 前提：本机已运行 Ollama 且暴露 OpenAI 兼容端点 http://localhost:11434/v1
#       （ollama serve 默认监听 11434；已 pull 模型如 deepseek-r1:7b：
#        `ollama pull deepseek-r1:7b`）
#
# 用法（任选其一）:
#   A) 仅导出给当前 shell（推荐先验证，不影响仓库其它配置）:
#        set -a; source deploy/.env.ollama.example; set +a
#        python -m yuleosh.cli ...   # 此后所有 LLM 调用走本地模型
#   B) 复制为 .env 由后端加载（取决于后端是否读取 .env）:
#        cp deploy/.env.ollama.example .env
#
# 两套配置二选一（互斥）:
# -----------------------------------------------------------------------------

# ── 方案 A（默认，推荐）：走 deepseek provider + 自定义 base_url ──────────────
# DeepSeekProvider 已实现 OpenAI 兼容调用，且认 LLM_BASE_URL / LLM_API_KEY。
# ⚠️ LLM_BASE_URL 只写到端点根（不含 /v1）——provider 与 legacy chat_completion
#    都会自行拼接 /v1/chat/completions，写成 .../v1 会重复成 .../v1/v1 而 404。
# 不设置 YULEOSH_LLM_PROVIDER 时默认 provider=deepseek（见
# src/yuleosh/llm/client.py resolve_config），所有任务（含审查/设计类，
# 默认路由到 claude-4-sonnet）都因 LLM_MODEL 落到下面的本地模型——除非你
# 显式设 YULEOSH_LLM_PROVIDER=anthropic（那会硬打 api.anthropic.com，不可用）。
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=deepseek-r1:7b

# ── 方案 B（可选）：显式走 openai provider + 自定义 base_url ─────────────────
# 仅当你想验证 OpenAIProvider 真实实现（方案 A 已落地的补齐项）时启用：
# 取消下面两行注释，并注释掉上面方案 A 的三行。OpenAIProvider 同样认
# LLM_BASE_URL / LLM_API_KEY，且 PROVIDER_KEY_ENVS 已含 LLM_API_KEY，
# 使 openai 路由在自建端点下可用（不会被 fallback 因「无 key」跳过）。
# YULEOSH_LLM_PROVIDER=openai
# LLM_MODEL=deepseek-r1:7b   # 与上面共用 LLM_BASE_URL / LLM_API_KEY 即可

# ── 统一入口（可选）：YULEOSH_LLM_UNIFIED=1 走 LLMClient.call 统一链路 ────────
# 默认关闭（保留遗留 chat_completion 路径）。开启后获得预算检查 / provider 回退
# / 成本审计。本地模型无费用，开启更贴近生产行为。
# YULEOSH_LLM_UNIFIED=1

# ── 注意事项 ────────────────────────────────────────────────────────────────
# - deepseek-r1 是推理模型，输出会带 <think>…<think> 思考块；介意可换
#   qwen2.5-coder:32b 等非推理模型（先 `ollama pull <tag>`）。
# - 不要设 YULEOSH_LLM_PROVIDER=openai 却不设 LLM_BASE_URL（会真打
#   https://api.openai.com，无 key 必失败）。
# - 验证是否生效：日志中 provider 字段应为 deepseek 或 openai、model 为本地 tag，
#   而非 mock；或直接看响应内容是否来自真实模型。
